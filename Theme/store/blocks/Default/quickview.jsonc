{
  //***************************************************************
  //
  //
  //***************************************************************
  //Inicio Trigger
  "modal-trigger#pdbx-quickview": {
    "props": {
      "blockClass": "pdbx-quickview"
    },
    "children": ["rich-text#pdbx-quickview", "modal-layout#pdbx-quickview"]
  },
  "rich-text#pdbx-quickview": {
    "props": {
      "blockClass": "pdbx-quickview",
      "text": "Agregar al carrito"
    }
  },
  //Fin Trigger
  //***************************************************************
  //
  //
  //***************************************************************
  //Inicio Modal
  "modal-layout#pdbx-quickview": {
    "props": {
      "blockClass": "pdbx-quickview"
    },
    "children": ["flex-layout.row#pdbx-quickview-close", "flex-layout.row#pdbx-quickview-main-info"]
  },
  //Close Button
  "flex-layout.row#pdbx-quickview-close": {
    "props": {
      "blockClass": "pdbx-quickview-close"
    },
    "children": ["modal-actions.close"]
  },
  //---------------------------------------------
  //Info
  //Main Container
  "flex-layout.row#pdbx-quickview-main-info": {
    "props": {
      "blockClass": "product-main-info"
    },
    "children": ["flex-layout.col#pdbx-quickview-left-col", "flex-layout.col#pdbx-quickview-rigth-col"]
  },
  //
  //
  //Left Column
  "flex-layout.col#pdbx-quickview-left-col": {
    "props": {
      "blockClass": "product-images",
      "width": "60%",
      "rowGap": 0,
      "preventVerticalStretch": true
    },
    "children": ["product-price-savings#product-box", "product-images"]
  },
  //
  //
  //Right Column
  "flex-layout.col#pdbx-quickview-rigth-col": {
    "props": {
      "blockClass": "product-info"
    },
    "children": ["flex-layout.row#pdbx-quickview-price", "flex-layout.row#pdbx-quickview-buy-product"]
  },
  //Price
  "flex-layout.row#pdbx-quickview-price": {
    "props": {
      "blockClass": ["pdbx-quickview-product-price", "product-price"]
    },
    "children": []
  },
  //
  //
  //Buy
  "flex-layout.row#pdbx-quickview-buy-product": {
    "props": {
      "blockClass": ["pdbx-quickview-buy-product"]
    },
    "children": ["product-quantity#pdbx-quickview", "add-to-cart-button#quickview"]
  },
  "product-quantity#pdbx-quickview": {
    "props": {
      "showLabel": true,
      "selectorType": "stepper",
      "blockClass": "product-page-quantity",
      "showUnit": false,
      "warningQuantityThreshold": 99999999
    }
  },
  "link.product#product-page": {
    "props": {
      "href": "/{slug}/p",
      "label": "Ver detalle"
    }
  },
  "add-to-cart-button#quickview": {
    "props": {
      "text": "Añadir al carrito",
      //"unavailableText": "No disponible",
      "blockClass": "pdp-add-to-cart-button",
      "customPixelEventName": "addTocart"
    }
  }

  //Fin Modal
  //***************************************************************
  //
  //
  //***************************************************************
}
