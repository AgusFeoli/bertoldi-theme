{
  //***************************************************************
  //
  //
  //***************************************************************
  //Inicio Trigger
  "modal-trigger#pdbx-quickview": {
    "props": {
      "blockClass": "pdbx-quickview"
    },
    "children": ["rich-text#pdbx-quickview", "modal-layout#pdbx-quickview"]
  },
  "rich-text#pdbx-quickview": {
    "props": {
      "blockClass": "pdbx-quickview",
      "text": "Agregar al carrito"
    }
  },
  //Fin Trigger
  //***************************************************************
  //
  //
  //***************************************************************
  //Inicio Modal
  "modal-layout#pdbx-quickview": {
    "props": {
      "blockClass": "pdbx-quickview"
    },
    "children": ["flex-layout.row#pdbx-quickview-close", "responsive-layout.desktop#pdbx-quickview", "responsive-layout.mobile#pdbx-quickview"]
  },
  //Close Button
  "flex-layout.row#pdbx-quickview-close": {
    "props": {
      "blockClass": "pdbx-quickview-close"
    },
    "children": ["modal-actions.close"]
  },
  //Desktop
  "responsive-layout.desktop#pdbx-quickview": {
    "title": "Página de Producto Desktop",
    "children": ["flex-layout.row#product-main-info"]
  },
  //Mobile
  "responsive-layout.mobile#pdbx-quickview": {
    "title": "Página de Producto Mobile",
    "children": ["flex-layout.row#pdbx-quickview-MB"]
  },
  "flex-layout.row#pdbx-quickview-MB": {
    "props": {
      "blockClass": "product-data-PDP-MB"
    },
    "children": [
      "flex-layout.row#product-image-MB",
      "flex-layout.row#product-brand",
      "flex-layout.row#product-name",
      "flex-layout.row#product-ID",
      "condition-layout.product#availability-MB",
      "flex-layout.col#product-description"
    ]
  }

  //Fin Modal
  //***************************************************************
  //
  //
  //***************************************************************
}
