{
  "flex-layout.row#marcas-slider": {
    "props": {
      "blockClass": "marcas-slider"
    },
    "children": ["rich-text#title-marcas-slider", "responsive-layout.desktop#marcas-slider", "responsive-layout.mobile#marcas-slider"]
  },

  //******************************************************
  // Título principal del slider
  //******************************************************
  "rich-text#title-marcas-slider": {
    "title": "Títutlo",
    "props": { "text": "Las principales marcas", "blockClass": "title-marcas-slider" }
  },

  "responsive-layout.desktop#marcas-slider": {
    "title": "Desktop",
    "children": [
      "link.product#marca-slider-1",
      "link.product#marca-slider-2",
      "link.product#marca-slider-3",
      "link.product#marca-slider-4",
      "link.product#marca-slider-5",
      "link.product#marca-slider-6"
    ]
  },
  "responsive-layout.mobile#marcas-slider": {
    "title": "Mobile",
    "children": ["slider-layout#marcas-slider"]
  },

  //******************************************************
  // Slider con todas las categorías
  //******************************************************
  "slider-layout#marcas-slider": {
    "title": "Slider",
    "children": [
      "link.product#marca-slider-1",
      "link.product#marca-slider-2",
      "link.product#marca-slider-3",
      "link.product#marca-slider-4",
      "link.product#marca-slider-5",
      "link.product#marca-slider-6"
    ],
    "props": {
      "blockClass": "marca-slider",
      "itemsPerPage": {
        "desktop": 5,
        "tablet": 3,
        "phone": 2
      },
      "centerMode": {
        "desktop": "disabled",
        "tablet": "to-the-left",
        "phone": "to-the-left"
      },
      "centerModeSlidesGap": 24,
      "autoplay": {
        "timeout": 3500,
        "stopOnHover": true
      },
      "fullWidth": true,
      "infinite": true,
      "showNavigationArrows": "desktopOnly",
      "showPaginationDots": "never"
    }
  },

