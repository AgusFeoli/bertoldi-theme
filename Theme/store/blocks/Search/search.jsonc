{
  "store.search": {
    "blocks": [
      "search-result-layout"
    ],
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "simulationBehavior": "default",
        "orderByField": "OrderByTopSaleDESC",
        "maxItemsPerPage": 20,
        "hideUnavailableItems": false
      }
    }
  },
  "store.search#category": {
    "blocks": [
      "search-result-layout"
    ],
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "simulationBehavior": "default",
        "orderByField": "OrderByTopSaleDESC",
        "maxItemsPerPage": 20,
        "hideUnavailableItems": false
      }
    }
  },
  "store.search#brand": {
    "blocks": [
      "search-result-layout"
    ],
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "simulationBehavior": "default",
        "orderByField": "OrderByTopSaleDESC",
        "maxItemsPerPage": 20,
        "hideUnavailableItems": false
      }
    }
  },
  "store.search#department": {
    "blocks": [
      "search-result-layout"
    ],
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "simulationBehavior": "default",
        "maxItemsPerPage": 20,
        "orderByField": "OrderByTopSaleDESC",
        "hideUnavailableItems": false
      }
    }
  },
  "store.search#subcategory": {
    "blocks": [
      "search-result-layout"
    ],
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "simulationBehavior": "default",
        "maxItemsPerPage": 20,
        "orderByField": "OrderByTopSaleDESC",
        "hideUnavailableItems": false
      }
    }
  },
  "search-result-layout": {
    "blocks": [
      "search-result-layout.desktop",
      "search-result-layout.mobile",
      "search-not-found-layout"
    ]
  },
  /* - Search desktop */
  "search-result-layout.desktop": {
    "children": [
      "search-banner#one",
      "flex-layout.row#bread-crumb",
      "flex-layout.row#result"
    ],
    "props": {
      "hiddenFilters": {
        "hideAll": true
      },
      "pagination": "show-more",
      "preventRouteChange": false,
      /*El siguiente parametro sirve para indicar a partir de cuantos inputs aparece el buscador de categoria*/
      //"thresholdForFacetSearch": 5,
      "showProductsCount": true,
      "showFacetQuantity": true,
      "mobileLayout": {
        "mode1": "small",
        "mode2": "normal"
      }
    }
  },
  /*-*/
  "flex-layout.row#result": {
    "children": [
      "flex-layout.col#filter",
      "flex-layout.col#content"
    ],
    "props": {
      "blockClass": "list-product-cont",
      "preventRouteChange": true,
      /*El siguiente parametro sirve para indicar a partir de cuantos inputs aparece el buscador de categoria*/
      //"thresholdForFacetSearch": 5,
      "showProductsCount": true,
      "showFacetQuantity": true,
      "rowGap": 0
    }
  },
  "flex-layout.col#filter": {
    "children": [
      "flex-layout.row#searchtitle",
      "filter-navigator.v3"
    ],
    "props": {
      "blockClass": "filterCol",
      "width": "20%",
      "rowGap": 0,
      "marginRight": 4
    }
  },
  "flex-layout.row#searchtitle": {
    "props": {
      "blockClass": "searchtitleCustom"
    },
    "children": [
      "search-title.v2"
    ]
  },
  "flex-layout.row#bread-crumb": {
    "props": {
      "blockClass": "bread-crumb"
    },
    "children": [
      "breadcrumb.search"
    ]
  },
  "breadcrumb.search": {
    "props": {
      "showOnMobile": true,
      "blockClass": "list-prod",
      "homeIconSize": 26
    }
  },
  "filter-navigator.v3": {
    "blocks": [
      "sidebar-close-button"
    ],
    "props": {
      "initiallyCollapsed": false,
      "navigationTypeOnMobile": "collapsible",
      "truncateFilters": true,
      "showClearByFilter": true,
      "fullWidthOnMobile": true,
      "appliedFiltersOverview": "show",
      "totalProductsOnMobile": "show",
      "updateOnFilterSelectionOnMobile": true,
      "priceRangeLayout": "inputAndSlider",
      "openFiltersMode": "many",
      "facetOrdering": [
        {
          "key": "category-1",
          "orderBy": "name",
          "order": "ASC"
        },
        {
          "key": "brand",
          "orderBy": "name",
          "order": "ASC"
        },
        {
          "key": "category-2",
          "orderBy": "name",
          "order": "ASC"
        },
        {
          "key": "category-3",
          "orderBy": "name",
          "order": "ASC"
        }
      ]
    }
  },
  "flex-layout.col#content": {
    "children": [
      "flex-layout.row#searchinfo",
      "flex-layout.row#products",
      "flex-layout.row#fetchmore"
    ],
    "props": {
      "preventVerticalStretch": true,
      "marginLeft": 4
    }
  },
  "flex-layout.row#searchinfo": {
    "props": {
      "blockClass": "search-info"
    },
    "children": [
      "flex-layout.col#title",
      "flex-layout.col#orderby"
    ]
  },
  "flex-layout.col#title": {
    "children": [
      "total-products.v2"
    ],
    "props": {
      "blockClass": "productCountCol"
    }
  },
  "flex-layout.col#orderby": {
    "children": [
      "order-by.v2"
    ],
    "props": {
      "blockClass": "orderByCol"
    }
  },
  "search-banner#one": {
    "props": {
      "area": "one",
      "blockClass": "bannerProdList",
      "horizontalAlignment": "center"
    }
  },
  "flex-layout.row#fetchprevious": {
    "props": {
      "marginBottom": 3,
      "blockClass": "fetchmore"
    },
    "children": [
      "search-fetch-previous"
    ]
  },
  "flex-layout.row#fetchmore": {
    "props": {
      "marginTop": 3,
      "blockClass": "fetchmore"
    },
    "children": [
      "search-products-count-per-page",
      "search-fetch-more"
    ]
  },
  "flex-layout.row#products": {
    "props": {
      "blockClass": "product-list"
    },
    "children": [
      "search-content"
    ]
  },
  "search-content": {
    "blocks": [
      "gallery",
      "not-found"
    ]
  },
  "gallery": {
    "props": {
      "blockClass": "container"
    },
    "blocks": [
      "product-summary.shelf#product-box"
    ]
  },
  /* - Search mobile */
  "search-result-layout.mobile": {
    "children": [
      "search-banner#one",
      "flex-layout.row#bread-crumb",
      "flex-layout.row#searchinfomobile",
      "flex-layout.row#productCountMobile",
      // "flex-layout.row#fetchprevious",
      "flex-layout.row#contentmobile",
      "flex-layout.row#fetchmore"
    ],
    "props": {
      "pagination": "show-more",
      "mobileLayout": {
        "mode1": "small",
        "mode2": "normal"
      },
      "preventRouteChange": true,
      /*El siguiente parametro sirve para indicar a partir de cuantos inputs aparece el buscador de categoria*/
      //"thresholdForFacetSearch": 5,
      "showProductsCount": true,
      "showFacetQuantity": true,
      "blockClass": "container"
    }
  },
  "flex-layout.row#contentmobile": {
    "children": [
      "search-content"
    ],
    "props": {
      "blockClass": "searchMobile",
      "preserveLayoutOnMobile": false
    }
  },
  "flex-layout.row#searchinfomobile": {
    "children": [
      "flex-layout.col#filterMobile",
      "flex-layout.col#orderByMobile"
    ],
    "props": {
      "blockClass": "filterOrderMobile",
      "preserveLayoutOnMobile": true,
      "colSizing": "equal",
      "colJustify": "around",
      "marginBottom": 0,
      "marginTop": 0
    }
  },
  "flex-layout.col#orderByMobile": {
    "children": [
      "order-by.v2"
    ],
    "props": {
      "blockClass": "orderByMobileCol",
      "paddingBottom": 0,
      "paddingTop": 0
    }
  },
  "flex-layout.row#productCountMobile": {
    "children": [
      "breadcrumb.search"
    ],
    "props": {
      "blockClass": "productCountMobileRow"
    }
  },
  "flex-layout.col#filterMobile": {
    "children": [
      "filter-navigator.v3"
    ],
    "props": {
      "blockClass": "filterMobileCol"
    }
  },
  "flex-layout.col#switcherMobile": {
    "children": [
      "search-layout-switcher"
    ],
    "props": {
      "blockClass": "switcherMobileCol"
    }
  },
  "rich-text#error404": {
    "props": {
      "text": "Tenemos un error"
    }
  },
  "order-by.v2": {
    "props": {
      "hiddenOptions": [
        "OrderByCollection"
      ]
    }
  }
}