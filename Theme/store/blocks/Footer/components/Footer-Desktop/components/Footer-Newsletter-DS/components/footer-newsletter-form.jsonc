{
  // COL CONTENEDORA DE FORM NEWSLETTER
  "flex-layout.col#footer-newsletter-form": {
    "children": [
      "form#newsletter"
    ],
    "props": {
      "blockClass": "newsletter-form-container"
    }
  },
  /* - Newsletter form - */
  "form#newsletter": {
    "props": {
      "entity": "NS", //Data Entity,
      "schema": "Form_Newsletter", //Form Schema,
      "blockClass": "newsletter-form"
    },
    "children": [
      "flex-layout.row#field-newsletter"
    ],
    "blocks": [
      "form-success#newsletter"
    ]
  },
  /*-*/
  "flex-layout.row#field-newsletter": {
    "props": {
      "blockClass": "field-newsletter"
    },
    "children": [
      "form-input.text#newsletter-email",
      "form-submit#newsletter"
    ]
  },
  "form-input.text#newsletter-email": {
    "props": {
      "pointer": "#/properties/email",
      "placeholder": "Ingresá tu mail"
    }
  },
  "form-submit#newsletter": {
    "props": {
      "label": "Suscribirme"
    }
  },
  /*-*/
  "form-success#newsletter": {
    "children": [
      "rich-text#success-newsletter"
    ]
  },
  "rich-text#success-newsletter": {
    "props": {
      "text": "Gracias por suscribirte a nuestro newsletter!",
      "blockClass": "form-success-ns"
    }
  }
}
