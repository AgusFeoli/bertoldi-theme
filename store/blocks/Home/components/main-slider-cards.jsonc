{
  "flex-layout.row#main-slider-cards-container": {
    "props": {
      "blockClass": "main-slider-cards-container"
    },
    "children": ["slider-layout#main-slider-card-slider"]
  },
  "slider-layout#main-slider-card-slider": {
    "children": [
      "flex-layout.row#main-slider-card-1",
      "flex-layout.row#main-slider-card-2",
      "flex-layout.row#main-slider-card-3",
      "flex-layout.row#main-slider-card-4",
      "flex-layout.row#main-slider-card-5",
      "flex-layout.row#main-slider-card-6"
    ],
    "props": {
      "blockClass": "main-slider-card-slider",
      "itemsPerPage": {
        "desktop": 3,
        "tablet": 2,
        "phone": 1
      },

      "centerMode": {
        "desktop": "to-the-left",
        "tablet": "to-the-left",
        "phone": "to-the-left"
      },
      "centerModeSlidesGap": 16,
      "autoplay": {
        "timeout": 3500,
        "stopOnHover": true
      },
      "fullWidth": true,
      "infinite": true,
      "showNavigationArrows": "desktopOnly",
      "showPaginationDots": "never"
    }
  },

  //******************************************************
  // Card 1
  //******************************************************
  "flex-layout.row#main-slider-card-1": {
    "title": "Tarjeta 1",
    "props": { "blockClass": "main-slider-cards" },
    "children": ["image#main-slider-image-1", "flex-layout.row#main-slider-info-container-1"]
  },
  "image#main-slider-image-1": {
    "title": "Imagen",
    "props": { "blockClass": "main-slider-image", "src": "/arquivos/image-slider.png" }
  },
  "flex-layout.row#main-slider-info-container-1": {
    "props": { "blockClass": ["main-slider-cards", "main-slider-info-container", "main-slider-info-container-background-dark"] },
    "children": ["rich-text#main-slider-title-1", "rich-text#main-slider-text-1", "link.product#main-slider-link-1"]
  },
  "rich-text#main-slider-title-1": {
    "title": "Título",
    "props": { "text": "Hasta 55% off", "blockClass": "main-slider-title" }
  },
  "rich-text#main-slider-text-1": {
    "title": "Texto",
    "props": { "text": "Lorem ipsum dolor sit amet consectetur. Morbi faucibus.", "blockClass": "main-slider-text" }
  },
  "link.product#main-slider-link-1": {
    "title": "Link CTA",
    "props": { "blockClass": "main-slider-link", "href": "/", "label": "¡Lo quiero!" }
  },

