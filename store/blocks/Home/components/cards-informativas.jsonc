    "props": {
      "blockClass": "slider-cards-informativas",
      "itemsPerPage": {
        "desktop": 3,
        "tablet": 2,
        "phone": 1
      },

      "centerMode": {
        "desktop": "center",
        "tablet": "to-the-left",
        "phone": "to-the-left"
      },
      "centerModeSlidesGap": 16,
      "fullWidth": true,
      "infinite": true,
      "showNavigationArrows": "never",
      "showPaginationDots": "never"
    }
  },
