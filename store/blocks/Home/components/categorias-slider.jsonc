{
  "flex-layout.row#categorias-slider": {
    "props": {
      "blockClass": "categorias-slider"
    },
    "children": ["rich-text#title-categoria-slider", "slider-layout#categorias-slider"]
  },

  //******************************************************
  // Título principal del slider
  //******************************************************
  "rich-text#title-categoria-slider": {
    "title": "Títutlo",
    "props": { "text": "Categorías", "blockClass": "title-categoria-slider" }
  },

  //******************************************************
  // Slider con todas las categorías
  //******************************************************
  "slider-layout#categorias-slider": {
    "title": "Slider",
    "children": [
      "link.product#categoria-slider-1",
      "link.product#categoria-slider-2",
      "link.product#categoria-slider-3",
      "link.product#categoria-slider-4",
      "link.product#categoria-slider-5",
      "link.product#categoria-slider-6",
      "link.product#categoria-slider-7",
      "link.product#categoria-slider-8",
      "link.product#categoria-slider-9"/*,
      "link.product#categoria-slider-10",
      "link.product#categoria-slider-11",
      "link.product#categoria-slider-12",
      "link.product#categoria-slider-13",
      "link.product#categoria-slider-14",
      "link.product#categoria-slider-15"*/
    ],
    "props": {
      "blockClass": "categorias-slider",
      "itemsPerPage": {
        "desktop": 9,
        "tablet": 4,
        "phone": 2
      },
      "centerMode": {
        "desktop": "disabled",
        "tablet": "to-the-left",
        "phone": "to-the-left"
      },
      "centerModeSlidesGap": 16,
      "autoplay": {
        "timeout": 3500,
        "stopOnHover": true
      },
      "fullWidth": true,
      "infinite": true,
      "showNavigationArrows": "desktopOnly",
      "showPaginationDots": "never"
    }
  },

  //******************************************************
  // Categoría 1
  //******************************************************
  "link.product#categoria-slider-1": {
    "title": "Categoría 1",
    "props": { "href": "/", "label": "Accesorios", "blockClass": "categoria-slider" },
    "children": ["image#categoria-slider-1"]
  },
  "image#categoria-slider-1": {
    "title": "Imagen",
    "props": { "blockClass": "categoria-slider", "src": "/arquivos/imagencategorianuevo.png" }
  },
  //******************************************************
  // Categoría 2
  //******************************************************
  "link.product#categoria-slider-2": {
    "title": "Categoría 2",
    "props": { "href": "/", "label": "Barbería", "blockClass": "categoria-slider" },
