    /* Info text */
    "rich-text#title-not-found": {
        "props": {
            "text": "No encontramos lo que buscabas",
            "blockClass": "title-not-found"
        }
    },
    "rich-text#text-not-found": {
        "props": {
            "blockClass": "text-not-found",
            "text": "**¿Qué podés hacer?** \n\n Escribirlo de otra manera. \n\n Podes encontrar productos similares a través del buscador. \n\n Utilizar sinónimos al término deseado. \n\n Si no sabes cómo llegaste aquí, visita nuestra home."
        }
    },
    /* Return home */
    "link#not-found-return": {
        "props": {
            "blockClass": "not-found-return",
            "href": "/",
            "label": "Volver a la página de inicio"
        }
    }
